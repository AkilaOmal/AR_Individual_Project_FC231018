  m_Script: {fileID: 11500000, guid: f0e6cd11deff1a5429a19d3185055e66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Module3Controller
  moduleName: REST vs GraphQL
  explanation: "REST exposes separate endpoints for each resource, so getting a student and their courses can take two requests. GraphQL has a single endpoint where the client writes a query listing exactly the fields it wants, so related data can come back in one request. REST can also be designed to return related data together; the difference is about flexibility and design, not that one is always better.\u201D"
  client: {fileID: 5145791386734306448}
  restServer: {fileID: 5930714137695234610}
